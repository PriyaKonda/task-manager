<h2>Signup</h2>
<%= form_with model: @user, url: signup_path do |f| %>
  <%= f.label :name %><br>
  <%= f.text_field :name %><br>

  <%= f.label :email %><br>
  <%= f.email_field :email %><br>

  <%= f.label :password %><br>
  <%= f.password_field :password %><br><br>

  <%= f.submit "Signup" %>
<% end %>

<%= link_to "Login", login_path %>
