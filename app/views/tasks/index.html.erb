<h2>My Tasks</h2>

<table border="1" cellpadding="6">
  <thead>
    <tr>
      <th>Title</th>
      <th>Description</th>
      <th>Status</th>
      <th>Priority</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr id="<%= dom_id(task) %>">
        <td><%= task.title %></td>
        <td><%= task.description %></td>
        <td><%= task.status %></td>
        <td><%= task.priority %></td>
        <td>
          <%= link_to "Show", task_path(task), class: "btn btn-info" %>
          <%= link_to "Edit", edit_task_path(task), class: "btn btn-secondary" %>
          <%= button_to "Delete", task_path(task),
                method: :delete,
                data: { turbo_confirm: "Are you sure you want to delete this task?" },
                class: "btn btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
